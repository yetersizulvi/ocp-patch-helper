{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenShift Patch Agent",
    "version": "0.5.1"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentPublicState"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/state": {
      "get": {
        "summary": "State",
        "operationId": "state_api_v1_state_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentPublicState"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentPublicState": {
        "properties": {
          "cluster_id": {
            "type": "string",
            "title": "Cluster Id"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "state": {
            "$ref": "#/components/schemas/RuntimeState"
          },
          "process_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Process Id"
          },
          "flow_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flow Name"
          },
          "target_tag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Tag"
          },
          "lease_expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lease Expires At"
          },
          "last_master_contact_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Master Contact At"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "collector_status": {
            "additionalProperties": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "object",
            "title": "Collector Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cluster_id",
          "environment",
          "state"
        ],
        "title": "AgentPublicState"
      },
      "RuntimeState": {
        "type": "string",
        "enum": [
          "STARTING",
          "IDLE",
          "RUNNING",
          "STOPPING",
          "ERROR"
        ],
        "title": "RuntimeState"
      }
    }
  }
}
