          "target_tag": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$",
            "title": "Target Tag"
          },
          "flow": {
            "type": "string",
            "title": "Flow",
            "default": "patch-live"
          },
          "clusters": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clusters"
          },
          "duration_minutes": {
            "type": "integer",
            "maximum": 720.0,
            "minimum": 1.0,
            "title": "Duration Minutes",
            "default": 60
          },
          "namespace_glob": {
            "type": "string",
            "title": "Namespace Glob",
            "default": "*"
          },
          "namespaces": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Namespaces"
          },
          "interval_seconds": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 3600.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Interval Seconds"
          },
          "tag_match_mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "exact",
                  "release"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Tag Match Mode"
          }
        },
        "type": "object",
        "required": [
          "target_tag"
        ],
        "title": "NewSession"
      },
      "SavedDesign": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "title": "Description",
            "default": ""
          },
          "settings": {
            "$ref": "#/components/schemas/NewSession"
          }
        },
        "type": "object",
        "required": [
          "name",
          "settings"
        ],
        "title": "SavedDesign"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
